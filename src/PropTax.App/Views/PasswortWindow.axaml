<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PropTax.App.Views.PasswortWindow"
        Title="PropTax – Datenbank entsperren" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Die Datenbank ist verschlüsselt." FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="Ordner" TextWrapping="Wrap" Foreground="#666" />
    <TextBox x:Name="Passwort" PasswordChar="●" PlaceholderText="Passwort" />
    <TextBlock x:Name="Meldung" Foreground="#B00020" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="Abbrechen" Content="Beenden" />
      <Button x:Name="Ok" Content="Entsperren" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
