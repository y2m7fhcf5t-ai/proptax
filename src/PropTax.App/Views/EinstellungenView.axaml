<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PropTax.App.ViewModels"
             xmlns:rw="using:PropTax.TaxEngine.Regelwerk"
             x:Class="PropTax.App.Views.EinstellungenView"
             x:DataType="vm:EinstellungenViewModel">
  <ScrollViewer>
    <StackPanel Spacing="6" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Classes="h2" Text="Datenordner" />
      <SelectableTextBlock Text="{Binding Datenordner}" />
      <TextBlock Classes="hinweis" Text="Enthält die Datenbank (proptax.db), alle Belegdateien (belege/) und Sicherungen (backup/)." />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Datenordner wechseln…" Command="{Binding DatenordnerWechselnCommand}" />
        <TextBlock Classes="label" Text="{Binding Version, StringFormat='Programmversion {0}'}" />
      </StackPanel>

      <TextBlock Classes="h2" Text="Datensicherung" />
      <TextBlock Classes="hinweis" Text="Beim Beenden wird automatisch gesichert (backup/auto_*.zip, die letzten 30 werden behalten). Manuelle Sicherungen werden nie automatisch gelöscht. Wiederherstellen legt vorher eine Sicherheitskopie an und beendet PropTax." />
      <DataGrid ItemsSource="{Binding Sicherungen}" SelectedItem="{Binding SicherungAuswahl}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="220" x:CompileBindings="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Datei" Binding="{Binding Datei}" /><DataGridTextColumn Header="Erstellt" Binding="{Binding Erstellt}" />
          <DataGridTextColumn Header="Art" Binding="{Binding Art}" /><DataGridTextColumn Header="Verschlüsselt" Binding="{Binding Verschluesselt}" />
          <DataGridTextColumn Header="Inhalt" Binding="{Binding Inhalt}" />
        </DataGrid.Columns>
      </DataGrid>
      <WrapPanel>
        <Button Content="Jetzt sichern" Command="{Binding JetztSichernCommand}" Classes="accent" />
        <TextBox Text="{Binding PwSicherung}" PasswordChar="●" PlaceholderText="Passwort der Sicherung (falls verschlüsselt)" Width="300" Margin="0,0,6,6" />
        <Button Content="Markierte bzw. Datei wiederherstellen…" Command="{Binding WiederherstellenCommand}" />
        <Button Content="Unverschlüsselte Sicherungen löschen" Command="{Binding UnverschluesselteLoeschenCommand}" />
      </WrapPanel>

      <TextBlock Classes="h2" Text="Verschlüsselung der Datenbank" />
      <TextBlock Text="{Binding VerschluesselungsStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Classes="hinweis" Text="Das Passwort wird nicht gespeichert und kann nicht wiederhergestellt werden – ohne Passwort sind die Daten verloren. Für die Belegdateien wird zusätzlich BitLocker empfohlen." />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Text="{Binding PwAlt}" PasswordChar="●" PlaceholderText="bisheriges Passwort" Width="200" IsVisible="{Binding IstVerschluesselt}" />
        <TextBox Text="{Binding PwNeu}" PasswordChar="●" PlaceholderText="neues Passwort (mind. 10 Zeichen)" Width="240" />
        <TextBox Text="{Binding PwWiederholung}" PasswordChar="●" PlaceholderText="Wiederholung" Width="200" />
      </StackPanel>
      <WrapPanel>
        <Button Content="Verschlüsseln" Command="{Binding VerschluesselnCommand}" IsVisible="{Binding !IstVerschluesselt}" Classes="accent" />
        <Button Content="Passwort ändern" Command="{Binding PasswortAendernCommand}" IsVisible="{Binding IstVerschluesselt}" />
        <Button Content="Verschlüsselung entfernen" Command="{Binding VerschluesselungEntfernenCommand}" IsVisible="{Binding IstVerschluesselt}" />
      </WrapPanel>

      <TextBlock Classes="h2" Text="Aktueller Stand" />
      <TextBlock Text="{Binding AktuellerStand}" TextWrapping="Wrap" />
      <TextBox Text="{Binding Begruendung}" PlaceholderText="Begründung (Pflicht für jede Änderung)" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="label" Text="Gültig ab" /><CalendarDatePicker SelectedDate="{Binding Ab_}" />
      </StackPanel>

      <TextBlock Classes="h2" Text="Besteuerungsart (§19 UStG)" />
      <ItemsControl ItemsSource="{Binding Historie}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="rw:BesteuerungsartAb">
            <TextBlock>
              <Run Text="{Binding Ab, StringFormat='ab {0:dd.MM.yyyy}: '}" />
              <Run Text="{Binding Art, Converter={x:Static vm:EnumAnzeigeKonverter.Instanz}}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ComboBox ItemsSource="{Binding Arten}" SelectedItem="{Binding Art}" Width="260">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static vm:EnumAnzeigeKonverter.Instanz}}" x:CompileBindings="False" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Ab Stichtag setzen" Command="{Binding BesteuerungsartSetzenCommand}" />
      </StackPanel>

      <TextBlock Classes="h2" Text="USt-Behandlung von Payouts (TODO-STEUER O-04)" />
      <TextBlock Classes="hinweis" Text="Fachlich offen – bitte mit Steuerberatung klären. Wirkt auf Kennzahl 45/81 und die §19-Grenze." />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ComboBox ItemsSource="{Binding PayoutOptionen}" SelectedItem="{Binding Payout}" Width="260" />
        <Button Content="Ab Stichtag setzen" Command="{Binding PayoutSetzenCommand}" />
      </StackPanel>

      <TextBlock Classes="h2" Text="Neuberechnung" />
      <TextBlock Classes="hinweis" Text="Berechnet gebuchte Belege in offenen Perioden neu (z. B. nach Kurskorrektur). Manuell übersteuerte und festgeschriebene Belege bleiben unverändert." />
      <Button Content="Offene Belege neu berechnen" Command="{Binding NeuBerechnenCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
