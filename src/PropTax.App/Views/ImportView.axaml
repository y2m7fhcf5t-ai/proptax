<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PropTax.App.ViewModels"
             xmlns:app="using:PropTax.Application"
             x:Class="PropTax.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <TabControl>
    <TabItem Header="CSV-Belegimport">
      <Grid ColumnDefinitions="380,*">
        <ScrollViewer Grid.Column="0">
          <StackPanel Spacing="4" Margin="0,0,8,0">
            <Button Content="CSV-Datei wählen…" Command="{Binding DateiWaehlenCommand}" />
            <TextBlock Classes="hinweis" Text="{Binding Datei}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ComboBox ItemsSource="{Binding Profile}" SelectedItem="{Binding ProfilAuswahl}" PlaceholderText="Gespeichertes Profil" Width="220" />
              <Button Content="Laden" Command="{Binding ProfilLadenCommand}" />
            </StackPanel>
            <TextBlock Classes="h2" Text="Format" />
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
              <TextBlock Classes="label" Text="Trennzeichen" /><TextBox Grid.Column="1" Text="{Binding Trennzeichen}" />
              <TextBlock Classes="label" Grid.Row="1" Text="Dezimalzeichen" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Dezimalzeichen}" />
              <TextBlock Classes="label" Grid.Row="2" Text="Datumsformat" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Datumsformat}" />
              <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Erste Zeile ist Kopfzeile" IsChecked="{Binding HatKopfzeile}" />
            </Grid>
            <TextBlock Classes="h2" Text="Spaltenzuordnung" />
            <ItemsControl ItemsSource="{Binding Zuordnungen}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SpaltenZuordnungVm">
                  <Grid ColumnDefinitions="140,*" Margin="0,2">
                    <TextBlock Classes="label" Text="{Binding FeldName}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Spalten}" SelectedItem="{Binding Spalte}" HorizontalAlignment="Stretch" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="h2" Text="Standardwerte" />
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
              <TextBlock Classes="label" Text="Betrieb" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Betriebe}" SelectedItem="{Binding Betrieb}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="app:BetriebDaten"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="label" Grid.Row="1" Text="Belegtyp" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Belegtypen}" SelectedItem="{Binding StandardTyp}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={x:Static vm:EnumAnzeigeKonverter.Instanz}}" x:CompileBindings="False" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="label" Grid.Row="2" Text="Partner" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Partner}" SelectedItem="{Binding StandardPartner}" HorizontalAlignment="Stretch" PlaceholderText="falls keine Partnerspalte">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="app:PartnerDaten"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="label" Grid.Row="3" Text="Währung" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StandardWaehrung}" />
              <TextBlock Classes="label" Grid.Row="4" Text="EÜR-Kategorie" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding EuerKategorien}" SelectedItem="{Binding EuerKategorie}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="app:EuerKategorieDaten"><TextBlock Text="{Binding Bezeichnung}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <CheckBox Content="Mögliche Dubletten trotzdem übernehmen" IsChecked="{Binding DublettenUebernehmen}" />
            <CheckBox Content="Bereits importierte Datei erneut einlesen" IsChecked="{Binding DateiErneut}" />
            <TextBox Text="{Binding ProfilName}" PlaceholderText="Profil speichern als … (optional)" />
            <WrapPanel>
              <Button Content="Vorschau aktualisieren" Command="{Binding VorschauAktualisierenCommand}" />
              <Button Content="Als Entwürfe importieren" Command="{Binding ImportierenCommand}" Classes="accent" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Column="1">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Zusammenfassung}" Margin="0,0,0,6" FontWeight="SemiBold" />
          <DataGrid ItemsSource="{Binding Vorschau}" IsReadOnly="True" AutoGenerateColumns="False" x:CompileBindings="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Zeile" Binding="{Binding Zeile}" />
              <DataGridTextColumn Header="Beleg" Binding="{Binding Belegnummer}" />
              <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" />
              <DataGridTextColumn Header="Betrag" Binding="{Binding Betrag}" />
              <DataGridTextColumn Header="Typ" Binding="{Binding Typ}" />
              <DataGridTextColumn Header="Prüfung" Binding="{Binding Status}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Grid>
    </TabItem>
    <TabItem Header="PDF-Belege zuordnen">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top">
          <Button Content="Ordner importieren…" Command="{Binding OrdnerImportierenCommand}" />
          <Button Content="Einzelne Datei…" Command="{Binding DokumentHinzufuegenCommand}" />
          <Button Content="Vorschläge aktualisieren" Command="{Binding VorschlaegeAktualisierenCommand}" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,8,*">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="h2" Text="Zuordnungsvorschläge" />
            <DataGrid x:Name="VorschlagListe" ItemsSource="{Binding Vorschlaege}" IsReadOnly="True" AutoGenerateColumns="False" x:CompileBindings="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Dokument" Binding="{Binding Dokument}" />
                <DataGridTextColumn Header="Beleg" Binding="{Binding Beleg}" />
                <DataGridTextColumn Header="Grund" Binding="{Binding Grund}" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <Button Content="Markierten Vorschlag übernehmen" Command="{Binding VorschlagUebernehmenCommand}" CommandParameter="{Binding #VorschlagListe.SelectedItem}" />
            <TextBlock Classes="h2" Text="Manuell zuordnen" />
            <ComboBox ItemsSource="{Binding OffeneDokumente}" SelectedItem="{Binding DokumentAuswahl}" PlaceholderText="Nicht zugeordnetes Dokument" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="app:DokumentInfo"><TextBlock Text="{Binding Dateiname}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding ZielBelegnummer}" PlaceholderText="Belegnummer" />
            <Button Content="Zuordnen" Command="{Binding ManuellZuordnenCommand}" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
