<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PropTax.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,8,0,4" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
    <Style Selector="TextBlock.hinweis"><Setter Property="Foreground" Value="#666" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button"><Setter Property="Margin" Value="0,0,6,6" /></Style>
    <Style Selector="CalendarDatePicker"><Setter Property="SelectedDateFormat" Value="Custom" /><Setter Property="CustomDateFormatString" Value="dd.MM.yyyy" /><Setter Property="PlaceholderText" Value="TT.MM.JJJJ" /></Style>
    <Style Selector="DataGrid"><Setter Property="GridLinesVisibility" Value="Horizontal" /></Style>
  </Application.Styles>
</Application>
